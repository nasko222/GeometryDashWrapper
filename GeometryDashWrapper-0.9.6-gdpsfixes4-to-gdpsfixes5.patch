+        if (!RunFunction(runtime_.ccnode_get_children, {node}, &children,
+                         "CCNode::getChildren scene scan", 0u,
+                         std::chrono::milliseconds(500)) || !children) return true;
+        for (u32 index = 0u; index < count && visited < 4096u; ++index) {
