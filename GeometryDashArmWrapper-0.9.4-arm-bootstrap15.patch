+            "$GD_ARM_QEMU_ZIG" c++ -target x86-windows-gnu "$@"
+        else
+            "$GD_ARM_QEMU_ZIG" cc -target x86-windows-gnu "$@"
+        fi
+    else
+        $compiler "$@"
+    fi
