diff --git a/cmake/bundle_static.cmake b/cmake/bundle_static.cmake
index 0123fe6..1e5878f 100644
--- a/cmake/bundle_static.cmake
+++ b/cmake/bundle_static.cmake
@@ -51,7 +51,12 @@ function(bundle_static_library tgt_name bundled_tgt_name library_name)
     OUTPUT_NAME "${library_name}"
     SYMLINK_NAME "${library_name}.o"
   )
-  add_custom_command(TARGET ${bundled_tgt_name} POST_BUILD
-    COMMAND ${CMAKE_COMMAND} -E create_symlink "$<TARGET_FILE_NAME:${bundled_tgt_name}>" "$<TARGET_FILE_DIR:${bundled_tgt_name}>/$<TARGET_PROPERTY:${bundled_tgt_name},SYMLINK_NAME>"
-  )
+  # The legacy .o alias is only needed by old Unix consumers. Creating it as
+  # a symbolic link on Windows requires Developer Mode or administrator
+  # privileges, while the wrapper links directly against libunicorn.a.
+  if (NOT WIN32)
+    add_custom_command(TARGET ${bundled_tgt_name} POST_BUILD
+      COMMAND ${CMAKE_COMMAND} -E create_symlink "$<TARGET_FILE_NAME:${bundled_tgt_name}>" "$<TARGET_FILE_DIR:${bundled_tgt_name}>/$<TARGET_PROPERTY:${bundled_tgt_name},SYMLINK_NAME>"
+    )
+  endif()
 endfunction()
diff --git a/qemu/configure b/qemu/configure
index cfd344f..4c4069c 100644
--- a/qemu/configure
+++ b/qemu/configure
@@ -56,6 +56,24 @@ error_exit() {
     exit 1
 }
 
+run_compiler() {
+    # The Windows portable builder drives CMake with `zig cc` as a compiler
+    # command list. Unicorn's CMake layer historically passes only the first
+    # list item (zig.exe) to this configure script, losing `cc -target ...`.
+    # Use the explicit Zig path supplied by the builder and preserve argv.
+    local compiler="$1"
+    shift
+    if test -n "${GD_ARM_QEMU_ZIG-}"; then
+        if test "$compiler" = "$cxx"; then
+            "$GD_ARM_QEMU_ZIG" c++ -target x86-windows-gnu "$@"
+        else
+            "$GD_ARM_QEMU_ZIG" cc -target x86-windows-gnu "$@"
+        fi
+    else
+        $compiler "$@"
+    fi
+}
+
 do_compiler() {
     # Run the compiler, capturing its output to the log. First argument
     # is compiler binary to execute.
@@ -67,7 +85,7 @@ funcs: ${FUNCNAME[*]}
 lines: ${BASH_LINENO[*]}"
     '; fi
     echo $compiler "$@" >> config.log
-    $compiler "$@" >> config.log 2>&1 || return $?
+    run_compiler "$compiler" "$@" >> config.log 2>&1 || return $?
     # Test passed. If this is an --enable-werror build, rerun
     # the test with -Werror and bail out if it fails. This
     # makes warning-generating-errors in configure test code
@@ -82,7 +100,7 @@ lines: ${BASH_LINENO[*]}"
         ;;
     esac
     echo $compiler -Werror "$@" >> config.log
-    $compiler -Werror "$@" >> config.log 2>&1 && return $?
+    run_compiler "$compiler" -Werror "$@" >> config.log 2>&1 && return $?
     error_exit "configure test passed without -Werror but failed with -Werror." \
         "This is probably a bug in the configure script. The failing command" \
         "will be at the bottom of config.log." \
