+    case 'W': return large ? 7 : 3;
+    case 'S': return large ? 8 : 4;
+    case 'E': return 11; /* clockwise on the x86-era editor ABI */
+    case 'Q': return 12; /* counter-clockwise */
+    default: return 0;
+    }
